# ==============================================================================
# FigCraft Server Deployment Configuration (.env)
# ==============================================================================
# Copy this file to .env and configure for your domain or server IP.
# Example: figcraft.zaief.com
# When PUBLIC_HOST is set, the server automatically sets:
#   public_url = wss://<PUBLIC_HOST>/
#   web_url    = https://<PUBLIC_HOST>/
PUBLIC_HOST=figcraft.zaief.com

# (Optional) Explicit override for public WebSocket endpoint:
# PUBLIC_URL=wss://figcraft.zaief.com/

# (Optional) Explicit override for public Web URL:
# WEB_URL=https://figcraft.zaief.com/

# Server network listening binding (0.0.0.0:47900 for public/docker networks)
LISTEN=0.0.0.0:47900

# Directory to persist documents, WAL logs, and snapshots
DATA_DIR=./figcraft-data

# Web dev server port (trunk)
WEB_PORT=8767
